// https://oldschool.runescape.wiki/w/Chicken#Drops
[ai_queue3,_chicken]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
inv_add(inv, npc_param(death_drop), 1);

// Tertiary
gosub(trail_checkmediumdrop);

// Normal drop
inv_add(inv, raw_chicken, 1);

// Other
def_int $rng = random(128);
if ($rng < 32) {
    inv_add(inv, feather, 15);
} else if ($rng < 64) {
    inv_add(inv, feather, 5);
}
