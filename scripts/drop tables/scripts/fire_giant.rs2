[ai_queue3,firegiant]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $random = random(128);

if ($random < 3) {
    inv_add(inv, steel_axe, 1);
} else if ($random < 5) {
    inv_add(inv, mithril_sq_shield, 1);
} else if ($random < 6) {
    inv_add(inv, fire_battlestaff, 1);
} else if ($random < 7) {
    inv_add(inv, rune_scimitar, 1);
} else if ($random < 17) {
    inv_add(inv, firerune, 150);
} else if ($random < 24) {
    inv_add(inv, chaosrune, 5);
} else if ($random < 29) {
    inv_add(inv, rune_arrow, 12);
} else if ($random < 33) {
    inv_add(inv, bloodrune, 5);
} else if ($random < 34) {
    inv_add(inv, firerune, 37);
} else if ($random < 35) {
    inv_add(inv, lawrune, 2);
} else if ($random < 54) {
    inv_add(inv, ~randomherb);
} else if ($random < 94) {
    inv_add(inv, coins, 60);
} else if ($random < 101) {
    inv_add(inv, coins, 15);
} else if ($random < 107) {
    inv_add(inv, coins, 25);
} else if ($random < 109) {
    inv_add(inv, coins, 300);
} else if ($random < 110) {
    inv_add(inv, coins, 50);
} else if ($random < 113) {
    inv_add(inv, lobster, 1);
} else if ($random < 115) {
    inv_add(inv, steel_bar, 1);
} else if ($random < 116) {
    inv_add(inv, 2dose1strength, 1);
} else if ($random < 127) {
    inv_add(inv, ~randomjewel);
} else if ($random <  128) {
    inv_add(inv, ~ultrarare_getitem);
}
