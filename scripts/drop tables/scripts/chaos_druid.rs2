[ai_queue3,chaos_druid]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

// Default drop from config.
inv_add(inv, npc_param(death_drop), 1);

def_int $random = random(128);

if ($random < 7)  {
    inv_add(inv, lawrune, 2);
} else if ($random < 10) {
    inv_add(inv, airrune, 36);
} else if ($random < 12) {
    inv_add(inv, bodyrune, 9);
} else if ($random < 14) {
    inv_add(inv, earthrune, 9);
} else if ($random < 16) {
    inv_add(inv, mindrune, 12);
} else if ($random < 17) {
    inv_add(inv, naturerune, 3);
} else if ($random < 52) {
    inv_add(inv, ~randomherb);
} else if ($random < 63) {
    inv_add(inv, ~randomherb);
    inv_add(inv, ~randomherb);
} else if ($random < 68) {
    inv_add(inv, coins, 3);
} else if ($random < 73) {
    inv_add(inv, coins, 8);
} else if ($random < 76) {
    inv_add(inv, coins, 29);
} else if ($random < 77) {
    inv_add(inv, coins, 35);
} else if ($random < 87) {
    inv_add(inv, vial_water, 1);
} else if ($random < 88) {
    inv_add(inv, bronze_longsword, 1);
} else if ($random < 89) {
    inv_add(inv, snape_grass, 1);
} else if ($random < 90 & %itgronigen >= ^itgronigen_complete) {
    inv_add(inv, unholy_symbol_mould, 1);
} else if ($random < 91) {
    inv_add(inv, ~randomjewel);
}
