[label,consume_effect_antipoison]
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
def_obj $consumable = last_item;
%poison = min(%poison,-5);
~set_poison_timer;
// change item to its next stage. default is null
// inv_setslot(inv, last_slot, oc_param($consumable, next_obj_stage), 1);
inv_del(inv, inv_getobj(inv, last_slot), 1);
inv_add(inv, oc_param($consumable, next_obj_stage), 1);
~consume_effect_messages($consumable, stat(hitpoints), false);

[label,consume_effect_super_antipoison]
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
def_obj $consumable = last_item;
%poison = min(%poison,-20);
~set_poison_timer;
// change item to its next stage. default is null
// inv_setslot(inv, last_slot, oc_param($consumable, next_obj_stage), 1);
inv_del(inv, inv_getobj(inv, last_slot), 1);
inv_add(inv, oc_param($consumable, next_obj_stage), 1);
~consume_effect_messages($consumable, stat(hitpoints), false);

[proc,auto_consume_antipoison]()(boolean)
if (inv_total(inv, 4doseantipoison) > 0) {
    inv_del(inv, 4doseantipoison, 1);
    inv_add(inv, 3doseantipoison, 1);
} else if (inv_total(inv, 3doseantipoison) > 0) {
    inv_del(inv, 3doseantipoison, 1);
    inv_add(inv, 2doseantipoison, 1);
} else if (inv_total(inv, 2doseantipoison) > 0) {
    inv_del(inv, 2doseantipoison, 1);
    inv_add(inv, 1doseantipoison, 1);
} else if (inv_total(inv, 1doseantipoison) > 0) {
    inv_del(inv, 1doseantipoison, 1);
} else {
    return(false);
}
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
%poison = min(%poison,-5);
~set_poison_timer;
mes("You drink some of your antipoison potion.");
return(true);

[proc,auto_consume_super_antipoison]()(boolean)
if (inv_total(inv, 4dose2antipoison) > 0) {
    inv_del(inv, 4dose2antipoison, 1);
    inv_add(inv, 3dose2antipoison, 1);
} else if (inv_total(inv, 3dose2antipoison) > 0) {
    inv_del(inv, 3dose2antipoison, 1);
    inv_add(inv, 2dose2antipoison, 1);
} else if (inv_total(inv, 2dose2antipoison) > 0) {
    inv_del(inv, 2dose2antipoison, 1);
    inv_add(inv, 1dose2antipoison, 1);
} else if (inv_total(inv, 1dose2antipoison) > 0) {
    inv_del(inv, 1dose2antipoison, 1);
} else {
    return(false);
}
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
%poison = min(%poison,-20);
~set_poison_timer;
mes("You drink some of your super antipoison potion.");
return(true);

