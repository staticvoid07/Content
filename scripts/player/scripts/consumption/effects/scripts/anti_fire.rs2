[label,consume_effect_antidragon]
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
def_obj $consumable = last_item;
%dragonresist = calc(map_clock + 600);
// change item to its next stage. default is null
// inv_setslot(inv, last_slot, oc_param($consumable, next_obj_stage), 1);
inv_del(inv, inv_getobj(inv, last_slot), 1);
inv_add(inv, oc_param($consumable, next_obj_stage), 1);
~consume_effect_messages($consumable, stat(hitpoints), false);

[proc,set_antifire_login]
if (%dragonresist < 1) {
    return;
}
%dragonresist = add(map_clock, %dragonresist);

[proc,set_antifire_logout]
if (%dragonresist < map_clock) {
    %dragonresist = null;
    return;
}
%dragonresist = sub(%dragonresist, map_clock);

[proc,auto_consume_antidragon]()(boolean)
if (inv_total(inv, 4dose1antidragon) > 0) {
    inv_del(inv, 4dose1antidragon, 1);
    inv_add(inv, 3dose1antidragon, 1);
} else if (inv_total(inv, 3dose1antidragon) > 0) {
    inv_del(inv, 3dose1antidragon, 1);
    inv_add(inv, 2dose1antidragon, 1);
} else if (inv_total(inv, 2dose1antidragon) > 0) {
    inv_del(inv, 2dose1antidragon, 1);
    inv_add(inv, 1dose1antidragon, 1);
} else if (inv_total(inv, 1dose1antidragon) > 0) {
    inv_del(inv, 1dose1antidragon, 1);
} else {
    return(false);
}
sound_synth(liquid, 0, 0);
anim(human_eat, 0);
%dragonresist = calc(map_clock + 600);
mes("You drink some of your dragon potion.");
return(true);
