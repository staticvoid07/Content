                    }
                case 49 : 
                    if (%itwatchtower < ^itwatchtower_complete) {
                        inv_del(inv, coins, $quest_price);
                        %itwatchtower = ^itwatchtower_complete;
                        inv_add(inv, watchtowerspell, 1);
                        stat_advance(magic, 153000);
                        inv_add(inv, coins, 5000);
                        %itwatchtower = ^itwatchtower_complete;
                        queue(itwatchtower_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 50 : 
                    if (%waterfall_quest < ^waterfall_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(waterfall_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 51 : 
                    if (%ballquest < ^ball_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(ball_quest_complete, 0, 0);
                    } else {
