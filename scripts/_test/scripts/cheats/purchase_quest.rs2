                        %crest_spells_levers_gauntlets = calc(pow(2, ^crest_south_lever) - 1);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 25 :
                    if (%arenaquest < ^arena_complete) {
                        inv_del(inv, coins, $quest_price);
                        %arenaquest = ^arena_defeated_genkhazard;
                        queue(arena_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 26 : 
                    if (%fishingcompo < ^fishingcompo_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(fishingcompo_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 27 : 
                    if (%fluffs < ^fluffs_complete) {
                        inv_del(inv, coins, $quest_price);
                        %fluffs = ^fluffs_complete;
                        queue(fluffs_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 28 : 
                    if (%grandtree < ^grandtree_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(grandtree_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 29 : 
                    if (%hazeelcultquest < ^hazeelcult_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(hazeelcult_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 30 : 
                    if(inv_total(inv, coins) >= 500000) {
                        if (%heroquest < ^hero_complete) {
                            inv_del(inv, coins, 500000);
                            queue(hero_quest_complete, 0, 0);
                        } else {
                            ~mesbox("That quest is already completed!");
                        }
                    } else {
                        ~mesbox("That quest costs 500k!");
                    }
                case 31 : 
                    if (%grail < ^grail_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(grail_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 32 : 
                    if (%junglepotion < ^junglepotion_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(junglepotion_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 33 :
                    if(inv_total(inv, coins) >= 500000) {
                        if (%legendsquest < ^legends_complete) {
                            inv_del(inv, coins, 500000);
                            %legendsquest = ^legends_radimus_training_4;
                            inv_add(inv, klanks_gauntlets, 1);
                            queue(legends_quest_complete, 0, 0);
                        } else {
                            ~mesbox("That quest is already completed!");
                        }
                    } else {
                        ~mesbox("That quest costs 500k!");
                    }
                case 34 : 
                    if (%zanaris < ^zanaris_complete) {
                        inv_del(inv, coins, $quest_price);
                        inv_add(inv, dramen_staff, 1);
                        queue(zanaris_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 35 : 
                    if (%arthur < ^arthur_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(arthur_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 36 : 
                    if (%drunkmonkquest < ^drunkmonk_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(drunkmonk_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 37 : 
                    if (%murderquest < ^murder_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(murder_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 38 :
                    if (%itgronigen < ^itgronigen_complete) {
                        inv_del(inv, coins, $quest_price);
                        stat_advance(crafting, 22500);
                        inv_add(inv, uncut_sapphire, 1);
                        %itgronigen = ^itgronigen_complete;
                        %qp = calc(%qp + ^itgronigen_questpoints);
                        queue(itgronigen_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 39 : 
                    if (%elenaquest < ^elena_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(quest_elena_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 40 : 
                    if (%scorpcatcher < ^scorpcatcher_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(scorpcatcher_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 41 : 
                    if (%seaslugquest < ^seaslug_complete) {
                        inv_del(inv, coins, $quest_price);
                        %seaslugquest = ^seaslug_complete;
                        %qp = add(%qp, ^seaslug_questpoints);
                        inv_add(inv, bigoysterpearls, 1);
                        stat_advance(fishing, 71750);
                        queue(seaslug_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 42 : 
                    if (%sheepherderquest < ^sheepherder_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(sheepherder_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 43 : 
                    if (%zombiequeen < ^zombiequeen_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(zombiequeen_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 44 :
                    if (%ikov < ^ikov_completed_lucien) {
                        if (%ikov < ^ikov_completed_armadyl) {
                            inv_del(inv, coins, $quest_price);
                            def_int $choice4 = ~p_choice2_header("Armadyl.", 0, "Lucien.", 1, "Choose a side for Temple of Ikov:");
                            if ($choice4 = 0) {
                                if (npc_find(0_40_51_13_57, ikov_lucien1, 7, 0) = true) {
                                    queue*(ikov_armadyl_quest_complete, 0)(npc_uid);
                                }
                            } else if ($choice4 = 1) {
                                queue(ikov_lucien_quest_complete, 0, 0);
                            }
                        } else {
                            ~mesbox("That quest is already completed!");
                        }
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 45 : 
                    if (%desertrescue < ^desertrescue_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(desertrescue_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 46 : 
                    if (%treequest < ^tree_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(tree_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 47 : 
                    if (%totemquest < ^totem_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(totem_quest_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 48 : 
                    if (%upass < ^upass_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(upass_quest_complete, 0, 0);
                    } else {
