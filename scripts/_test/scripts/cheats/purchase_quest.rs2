                    }
                case 53 : 
                    if (%priestperil < ^priestperil_complete) {
                        inv_del(inv, coins, $quest_price);
                        %priestperil = ^priestperil_complete;
                        queue(priestperil_complete, 0, 0);
                    } else {
                        ~mesbox("That quest is already completed!");
                    }
                case 54 :
                    if (%druidspirit < ^druidspirit_complete) {
                        inv_del(inv, coins, $quest_price);
                        queue(druidspirit_quest_complete, 0, 0);
                    }
                case 55 : 
                    if (%death_equiproom < ^death_complete) {
                        inv_del(inv, coins, $quest_price);
                        inv_add(inv, death_climbingboots, 1);
                        inv_add(inv, death_spikedboots, 1);
                        queue(death_quest_complete, 0, 0);
                    }
                case 56 :
                    if (%troll_quest < ^troll_complete) {
                        inv_del(inv, coins, $quest_price);
